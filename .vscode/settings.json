{
    "java.autobuild.enabled": true,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "java.compile.nullAnalysis.mode": "automatic",
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m -Xlog:disable -javaagent:C:/it/it_backend/lib/lombok.jar",
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,
    "java.debug.settings.onBuildFailureProceed": true,
    "files.exclude": {
        "**/bin": true // vscode에서 build와 bin 영역 class가 충돌(already defined)나는 문제 해결
    },
    "editor.defaultFormatter": "redhat.java",
    "[java]": {
        "editor.defaultFormatter": "redhat.java", // 또는 google-java-format
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },

    // ─────────────────────────────────────────────────────────────────────────
    //  Tailwind CSS / Nuxt 프론트엔드 설정 (it_frontend)
    //  - main.css의 @tailwind, @apply 지시어를 VS Code 내장 CSS LS가 모르므로
    //    내장 validator를 끄고 *.css 파일을 tailwindcss 언어 모드로 매핑합니다.
    //  - Tailwind CSS IntelliSense 확장(bradlc.vscode-tailwindcss)이 정확한 진단 제공.
    // ─────────────────────────────────────────────────────────────────────────
    "css.validate": false,
    "scss.validate": false,
    "less.validate": false,
    "css.lint.unknownAtRules": "ignore",
    "scss.lint.unknownAtRules": "ignore",
    "less.lint.unknownAtRules": "ignore",
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "tailwindCSS.includeLanguages": {
        "vue": "html",
        "vue-html": "html"
    },
    "[vue]": {
        "editor.defaultFormatter": "Vue.volar"
    }
}
