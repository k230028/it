{
    "java.autobuild.enabled": true,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "java.compile.nullAnalysis.mode": "automatic",
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m -Xlog:disable -javaagent:C:/it/it_backend/lib/lombok.jar",
    // Gradle 배포판은 wrapper 설치 경로가 아니라 직접 풀어둔 설치본을 사용합니다.
    // 이 PC에서는 .gradle\wrapper\dists 의 zip rename 이 보안 프로그램에 막혀
    // 확장(vscjava.vscode-gradle)이 배포판을 매번 삭제하고 재설치하다 실패했습니다.
    // 터미널의 ./gradlew 는 wrapper 를 그대로 사용하므로 영향이 없습니다.
    "java.import.gradle.wrapper.enabled": false,
    "java.import.gradle.home": "C:/gradle/gradle-9.2.1",
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,
    "java.debug.settings.onBuildFailureProceed": true,
    // bin은 JDT(Buildship) 컴파일 출력 폴더입니다. 탐색기에서만 숨깁니다.
    // 주의: files.exclude는 UI·검색 필터일 뿐 클래스패스나 프로젝트 임포트에 영향이 없습니다.
    "files.exclude": {
        "**/bin": true
    },
    // bin 아래에 .project/build.gradle이 생기면 JDT가 이를 별도 프로젝트로 임포트해
    // 같은 클래스가 두 출력 루트(bin/main, build/classes/java/main)로 올라가고
    // Spring 기동이 BeanDefinitionOverrideException(already defined)으로 실패합니다.
    // .worktrees 하위에는 같은 이름의 it_backend 체크아웃이 있어 JDT가 프로젝트명
    // it-it_backend를 중복 등록하고 "Duplicate root element"로 임포트가 실패합니다.
    // 워크트리는 각자의 창에서 열어 작업합니다.
    // 아래 목록은 확장 기본값 4개 + **/bin/** + **/.worktrees/** 입니다.
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/maven/**",
        "**/bin/**",
        "**/.worktrees/**"
    ],
    "editor.defaultFormatter": "redhat.java",
    "[java]": {
        "editor.defaultFormatter": "redhat.java", // 또는 google-java-format
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },

    // ─────────────────────────────────────────────────────────────────────────
    //  Tailwind CSS / Nuxt 프론트엔드 설정 (it_frontend)
    //  - main.css의 @tailwind, @apply 지시어를 VS Code 내장 CSS LS가 모르므로
    //    내장 validator를 끄고 *.css 파일을 tailwindcss 언어 모드로 매핑합니다.
    //  - Tailwind CSS IntelliSense 확장(bradlc.vscode-tailwindcss)이 정확한 진단 제공.
    // ─────────────────────────────────────────────────────────────────────────
    "css.validate": false,
    "scss.validate": false,
    "less.validate": false,
    "css.lint.unknownAtRules": "ignore",
    "scss.lint.unknownAtRules": "ignore",
    "less.lint.unknownAtRules": "ignore",
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "tailwindCSS.includeLanguages": {
        "vue": "html",
        "vue-html": "html"
    },
    "[vue]": {
        "editor.defaultFormatter": "Vue.volar"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    }
}
